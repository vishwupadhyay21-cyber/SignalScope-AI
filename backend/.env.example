# ============================================================
# SignalScope Backend — Environment Configuration Template
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to source control.
# ============================================================

# Application Settings
PROJECT_NAME="SignalScope Backend"
VERSION="0.1.0"
API_V1_STR="/api/v1"
# Use "development" locally; set "production" on your server to disable Swagger UI.
ENVIRONMENT="development"

# Server Settings
HOST="0.0.0.0"
PORT=8000
# Always False in production — prevents interactive tracebacks from being served.
DEBUG=False

# Logging
LOG_LEVEL="INFO"

# CORS Origins
# In development you can use ["*"] since credentials are not required.
# In production, replace with your actual frontend origin(s):
#   CORS_ORIGINS=["https://your-frontend-domain.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Image Upload & Validation
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_DIMENSION=8192
ALLOWED_IMAGE_FORMATS=["JPEG","PNG","WEBP"]
# Hard body-read cap applied before image decoding.
# Must be >= MAX_IMAGE_SIZE_MB; extra headroom covers multipart/form-data overhead.
MAX_REQUEST_BODY_SIZE_MB=12
