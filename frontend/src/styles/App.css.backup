/* SignalScope Application & Component Styles */

.app-wrapper {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.main-content {
  flex: 1;
  max-width: 1280px;
  width: 100%;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 4rem;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* Header */
.app-header {
  border-bottom: 1px solid var(--border-subtle);
  background: rgba(9, 13, 22, 0.85);
  backdrop-filter: blur(12px);
  position: sticky;
  top: 0;
  z-index: 50;
}

.header-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.brand-section {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.brand-logo-icon {
  width: 38px;
  height: 38px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(16, 185, 129, 0.15));
  border: 1px solid rgba(6, 182, 212, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-cyan);
  box-shadow: 0 0 16px rgba(6, 182, 212, 0.2);
}

.brand-title {
  font-size: 1.35rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  background: linear-gradient(to right, #f8fafc, #94a3b8);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.brand-subtitle {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--accent-cyan);
  font-weight: 600;
}

.header-meta {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.sih-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 0.35rem 0.75rem;
  border-radius: 9999px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
}

.health-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.75rem;
  font-weight: 500;
  padding: 0.35rem 0.8rem;
  border-radius: 9999px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border-subtle);
  transition: all var(--transition-fast);
}

.health-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  transition: background-color var(--transition-normal);
}

.health-pill.healthy .health-dot {
  background-color: var(--verdict-real);
  box-shadow: 0 0 8px var(--verdict-real);
}

.health-pill.unhealthy .health-dot {
  background-color: var(--verdict-ai);
  box-shadow: 0 0 8px var(--verdict-ai);
}

/* Hero Section */
.hero-section {
  text-align: center;
  max-width: 780px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.hero-pill {
  align-self: center;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 0.3rem 0.9rem;
  border-radius: 9999px;
  background: rgba(6, 182, 212, 0.1);
  border: 1px solid rgba(6, 182, 212, 0.25);
  color: var(--accent-cyan);
}

.hero-title {
  font-size: 2.25rem;
  font-weight: 800;
  line-height: 1.2;
}

.hero-gradient {
  background: linear-gradient(135deg, #38bdf8 0%, #06b6d4 50%, #10b981 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-description {
  font-size: 1rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* Upload Dropzone */
.dropzone-container {
  border: 2px dashed var(--border-medium);
  border-radius: var(--radius-xl);
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  padding: 3.5rem 2rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.25rem;
  cursor: pointer;
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.dropzone-container:hover,
.dropzone-container:focus-visible {
  border-color: var(--accent-cyan);
  background: var(--bg-card-hover);
  box-shadow: var(--shadow-glow-cyan);
}

.dropzone-container.is-dragover {
  border-color: #38bdf8;
  background: rgba(6, 182, 212, 0.08);
  box-shadow: 0 0 32px rgba(6, 182, 212, 0.3);
  transform: scale(1.008);
}

.dropzone-icon-box {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: rgba(6, 182, 212, 0.1);
  border: 1px solid rgba(6, 182, 212, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-cyan);
  transition: transform var(--transition-normal);
}

.dropzone-container:hover .dropzone-icon-box {
  transform: translateY(-4px);
}

.dropzone-text-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.dropzone-title {
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--text-primary);
}

.dropzone-highlight {
  color: var(--accent-cyan);
  text-decoration: underline;
  text-underline-offset: 4px;
}

.dropzone-spec {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.dropzone-tags {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.format-tag {
  font-size: 0.7rem;
  font-family: var(--font-mono);
  font-weight: 600;
  padding: 0.25rem 0.6rem;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
}

/* File Preview Card */
.preview-card {
  background: var(--bg-card);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
}

.preview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  min-height: 440px;
}

.preview-viewport {
  background: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  border-right: 1px solid var(--border-subtle);
  min-height: 380px;
}

.preview-image {
  max-width: 100%;
  max-height: 520px;
  object-fit: contain;
  display: block;
}

/* Telemetry Scan Effect in Preview */
.scan-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.scan-line {
  position: absolute;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, #06b6d4, #10b981, transparent);
  box-shadow: 0 0 12px #06b6d4;
  animation: scanSweep 2.2s infinite ease-in-out;
}

@keyframes scanSweep {
  0% { top: 0%; opacity: 0.2; }
  50% { opacity: 1; }
  100% { top: 100%; opacity: 0.2; }
}

.preview-sidebar {
  padding: 2rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 1.5rem;
  background: rgba(15, 23, 42, 0.6);
}

.file-meta-header {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.meta-badge {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.75rem;
  padding: 0.3rem 0.7rem;
  border-radius: var(--radius-sm);
  background: rgba(6, 182, 212, 0.12);
  color: var(--accent-cyan);
  font-weight: 600;
}

.file-name-display {
  font-size: 1.15rem;
  font-weight: 600;
  word-break: break-all;
}

.file-stat-row {
  display: flex;
  gap: 1.5rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border-subtle);
}

.file-stat-item {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.stat-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
}

.stat-value {
  font-size: 0.95rem;
  font-family: var(--font-mono);
  font-weight: 500;
  color: var(--text-primary);
}

.action-button-group {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.btn-primary {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.95rem 1.5rem;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 1rem;
  background: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
  color: #ffffff;
  box-shadow: 0 4px 20px rgba(6, 182, 212, 0.35);
}

.btn-primary:hover:not(:disabled) {
  background: linear-gradient(135deg, #0891b2 0%, #0369a1 100%);
  box-shadow: 0 6px 24px rgba(6, 182, 212, 0.5);
  transform: translateY(-1px);
}

.btn-secondary {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.75rem 1.25rem;
  border-radius: var(--radius-md);
  font-weight: 500;
  font-size: 0.9rem;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
}

.btn-secondary:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--border-medium);
  color: var(--text-primary);
}

.btn-danger {
  color: #fb7185;
}

.btn-danger:hover:not(:disabled) {
  background: rgba(244, 63, 94, 0.12);
  border-color: rgba(244, 63, 94, 0.3);
  color: #f43f5e;
}

/* Loading State */
.loading-box {
  padding: 3rem 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
}

.spinner-forensic {
  width: 64px;
  height: 64px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner-outer {
  width: 100%;
  height: 100%;
  border: 3px solid rgba(6, 182, 212, 0.15);
  border-top-color: var(--accent-cyan);
  border-radius: 50%;
  animation: spin 1s infinite linear;
}

.spinner-inner {
  position: absolute;
  width: 42px;
  height: 42px;
  border: 2px dashed rgba(16, 185, 129, 0.4);
  border-bottom-color: var(--verdict-real);
  border-radius: 50%;
  animation: spinReverse 1.5s infinite linear;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes spinReverse {
  to { transform: rotate(-360deg); }
}

.loading-steps {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: var(--text-secondary);
}

.loading-step-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.step-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-cyan);
  animation: pulse 1.2s infinite ease-in-out;
}

@keyframes pulse {
  0%, 100% { opacity: 0.3; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.1); }
}

/* Result Section */
.results-section {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.results-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border-subtle);
}

.analysis-id-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8rem;
  padding: 0.35rem 0.75rem;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
}

/* Verdict Banner */
.verdict-banner {
  border-radius: var(--radius-xl);
  padding: 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.verdict-banner.verdict-ai {
  background: linear-gradient(135deg, rgba(244, 63, 94, 0.12) 0%, rgba(15, 23, 42, 0.9) 100%);
  border: 1px solid var(--verdict-ai-border);
  box-shadow: var(--shadow-glow-ai);
}

.verdict-banner.verdict-real {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(15, 23, 42, 0.9) 100%);
  border: 1px solid var(--verdict-real-border);
  box-shadow: var(--shadow-glow-real);
}

.verdict-main-info {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.verdict-icon-container {
  width: 68px;
  height: 68px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.verdict-ai .verdict-icon-container {
  background: rgba(244, 63, 94, 0.15);
  border: 1px solid rgba(244, 63, 94, 0.4);
  color: var(--verdict-ai);
}

.verdict-real .verdict-icon-container {
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.4);
  color: var(--verdict-real);
}

.verdict-text-block {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.verdict-subheading {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  font-weight: 600;
}

.verdict-title {
  font-size: 1.85rem;
  font-weight: 800;
}

.verdict-ai .verdict-title {
  color: #fda4af;
}

.verdict-real .verdict-title {
  color: #6ee7b7;
}

.verdict-framing-note {
  font-size: 0.85rem;
  color: var(--text-secondary);
  max-width: 540px;
}

.verdict-score-block {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.confidence-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.95rem;
  border-radius: var(--radius-md);
  font-weight: 700;
  font-size: 1.25rem;
  font-family: var(--font-mono);
}

.verdict-ai .confidence-chip {
  background: rgba(244, 63, 94, 0.2);
  border: 1px solid rgba(244, 63, 94, 0.4);
  color: #fff;
}

.verdict-real .confidence-chip {
  background: rgba(16, 185, 129, 0.2);
  border: 1px solid rgba(16, 185, 129, 0.4);
  color: #fff;
}

.confidence-label {
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Results Grid */
.results-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

/* Card General */
.forensic-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  box-shadow: var(--shadow-md);
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border-subtle);
}

.card-title {
  font-size: 1.1rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Probabilities Visualization */
.prob-meter-group {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.prob-item {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.prob-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.9rem;
}

.prob-name {
  font-weight: 500;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.prob-val {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 1.05rem;
}

.prob-track {
  height: 10px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 9999px;
  overflow: hidden;
  position: relative;
}

.prob-fill {
  height: 100%;
  border-radius: 9999px;
  transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.prob-fill.ai {
  background: linear-gradient(90deg, #f43f5e, #fb7185);
  box-shadow: 0 0 10px rgba(244, 63, 94, 0.5);
}

.prob-fill.real {
  background: linear-gradient(90deg, #10b981, #34d399);
  box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
}

.prob-explanation-note {
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.02);
  padding: 0.75rem 1rem;
  border-radius: var(--radius-md);
  border-left: 2px solid var(--accent-cyan);
}

/* Metadata Grid */
.metadata-table {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.meta-field {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  background: rgba(255, 255, 255, 0.02);
  padding: 0.65rem 0.85rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-subtle);
}

.meta-field-label {
  font-size: 0.72rem;
  text-transform: uppercase;
  color: var(--text-muted);
  letter-spacing: 0.06em;
}

.meta-field-val {
  font-size: 0.88rem;
  font-family: var(--font-mono);
  color: var(--text-primary);
  font-weight: 500;
  word-break: break-all;
}

.metadata-absent-banner {
  background: rgba(245, 158, 11, 0.08);
  border: 1px dashed rgba(245, 158, 11, 0.3);
  border-radius: var(--radius-md);
  padding: 1.25rem;
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  color: #fde68a;
  font-size: 0.85rem;
  line-height: 1.5;
}

.metadata-forensic-rule {
  font-size: 0.78rem;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.03);
  padding: 0.75rem;
  border-radius: var(--radius-sm);
  border-left: 2px solid #64748b;
}

/* Extensible / Bonus Sections */
.extensible-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

.cues-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.cue-tag {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  font-size: 0.85rem;
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.03);
  padding: 0.6rem 0.8rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-subtle);
}

/* Error Banner */
.error-banner {
  background: rgba(244, 63, 94, 0.12);
  border: 1px solid rgba(244, 63, 94, 0.35);
  border-radius: var(--radius-lg);
  padding: 1.25rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  color: #fecdd3;
  animation: shake 0.35s ease-in-out;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4px); }
  75% { transform: translateX(4px); }
}

.error-content {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  font-size: 0.95rem;
}

/* Ethics & SIH Disclaimer Footer */
.app-footer {
  border-top: 1px solid var(--border-subtle);
  background: rgba(9, 13, 22, 0.95);
  padding: 2.5rem 1.5rem;
  margin-top: auto;
}

.footer-container {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.disclaimer-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 1.25rem 1.5rem;
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.disclaimer-icon {
  color: var(--accent-cyan);
  flex-shrink: 0;
  margin-top: 0.2rem;
}

.disclaimer-text {
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.6;
}

.footer-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* Responsive Media Queries */
@media (max-width: 960px) {
  .preview-grid {
    grid-template-columns: 1fr;
  }
  .preview-viewport {
    border-right: none;
    border-bottom: 1px solid var(--border-subtle);
    min-height: 300px;
  }
  .results-grid {
    grid-template-columns: 1fr;
  }
  .extensible-grid {
    grid-template-columns: 1fr;
  }
  .verdict-banner {
    flex-direction: column;
    align-items: flex-start;
  }
  .verdict-score-block {
    text-align: left;
  }
}

@media (max-width: 640px) {
  .main-content {
    padding: 1.5rem 1rem 3rem;
    gap: 1.5rem;
  }
  .hero-title {
    font-size: 1.75rem;
  }
  .dropzone-container {
    padding: 2.5rem 1.25rem;
  }
  .metadata-table {
    grid-template-columns: 1fr;
  }
  .header-meta {
    display: none;
  }
}
